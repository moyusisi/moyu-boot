<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot 默认的logback配置，这里面定义了 CONSOLE_LOG_PATTERN, FILE_LOG_PATTERN 等日志格式, 可参考 DefaultLogbackConfiguration 类 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>

    <!-- 日志存放路径 -->
    <property name="LOG_HOME" value="/var/logs/${APP_NAME}"/>
    <springProfile name="local">
        <property name="LOG_HOME" value="logs/${APP_NAME}"/>
    </springProfile>
    <!-- 日志输出格式 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId}] %-5level [%t] %-40.40logger{39} [%method:%line] : %m%n"/>

    <!-- consoleAppender 输出到控制台 -->
    <appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder charset="UTF-8">
<!--            <pattern>${CONSOLE_LOG_PATTERN}</pattern>-->
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 输出到文件日志 -->
    <appender name="fileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/info.log</file>
        <encoder charset="UTF-8">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/info.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>512MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 业务日志级别 -->
    <logger name="com.moyu.boot" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>

    <!-- 兜底日志 -->
    <root level="INFO">
        <appender-ref ref="consoleAppender"/>
        <!-- 生产环境. -->
        <springProfile name="prod">
            <appender-ref ref="fileAppender"/>
        </springProfile>
    </root>

</configuration>
